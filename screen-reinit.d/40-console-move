#!/bin/sh
# 40-console-move: Move xconsole to the bottom-right corner

# Validate window ID is in hex format (0xNNNNNNNN)
is_valid_window_id() {
    case $1 in
        0x[0-9a-fA-F]*) return 0 ;;
        *) return 1 ;;
    esac
}

# Find the window ID of xconsole
# xconsole usually has the WM_CLASS "xconsole.XConsole"
WID=$(wmctrl -l -x | grep "XConsole" | awk '{print $1}' | head -n 1)

if [ -z "$WID" ]; then
    exit 0
fi

if ! is_valid_window_id "$WID"; then
    echo "Error: Invalid window ID format." >&2
    exit 1
fi

# Get screen dimensions
SCREEN_W=$(xwininfo -root | grep 'Width:' | awk '{print $2}')
SCREEN_H=$(xwininfo -root | grep 'Height:' | awk '{print $2}')

# Get window dimensions (absolute positions include frame)
WIN_INFO=$(xwininfo -id "$WID")
WIN_X=$(echo "$WIN_INFO" | grep 'Absolute upper-left X:' | awk '{print $NF}')
WIN_Y=$(echo "$WIN_INFO" | grep 'Absolute upper-left Y:' | awk '{print $NF}')
WIN_W=$(echo "$WIN_INFO" | grep 'Width:' | awk '{print $NF}')
WIN_H=$(echo "$WIN_INFO" | grep 'Height:' | awk '{print $NF}')

# Calculate frame offset (difference between absolute and relative positions)
FRAME_X=$(echo "$WIN_INFO" | grep 'Relative upper-left X:' | awk '{print $NF}')
FRAME_Y=$(echo "$WIN_INFO" | grep 'Relative upper-left Y:' | awk '{print $NF}')
FRAME_L=$((WIN_X - FRAME_X))
FRAME_T=$((WIN_Y - FRAME_Y))

# Calculate coordinates (bottom-right with small margin)
MARGIN=2
FINAL_X=$((SCREEN_W - WIN_W - FRAME_L - MARGIN))
FINAL_Y=$((SCREEN_H - WIN_H - FRAME_T - MARGIN))

# Move the window
# -e gravity,x,y,width,height (-1 means leave unchanged)
wmctrl -i -r "$WID" -e "0,${FINAL_X},${FINAL_Y},-1,-1"
