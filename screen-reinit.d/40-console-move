#!/bin/sh
# 40-console-move: Move xconsole to the bottom-right corner

# Find the window ID of xconsole
# xconsole usually has the WM_CLASS "xconsole.XConsole"
WID=$(wmctrl -l -x | grep "XConsole" | awk '{print $1}' | head -n 1)

if [ -z "$WID" ]; then
    exit 0
fi

# Get screen dimensions
SCREEN_W=$(xwininfo -root | grep 'Width:' | awk '{print $2}')
SCREEN_H=$(xwininfo -root | grep 'Height:' | awk '{print $2}')

# Get window dimensions
WIN_INFO=$(xwininfo -id "$WID")
WIN_W=$(echo "$WIN_INFO" | grep 'Width:' | awk '{print $NF}')
WIN_H=$(echo "$WIN_INFO" | grep 'Height:' | awk '{print $NF}')

# Calculate coordinates (bottom-right)
FINAL_X=$((SCREEN_W - WIN_W))
FINAL_Y=$((SCREEN_H - WIN_H))

# Move the window
# -e gravity,x,y,width,height (-1 means leave unchanged)
wmctrl -i -r "$WID" -e "0,${FINAL_X},${FINAL_Y},-1,-1"
